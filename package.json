{
	"name": "@lct-testkit/rt-ui",
	"version": "0.1.1",
	"description": "Svelte 5 port of the Rostelecom Atomaro design system (gen2), pixel-matched to the React reference",
	"type": "module",
	"license": "UNLICENSED",
	"repository": { "type": "git", "url": "git+https://github.com/lct-testkit/rt-ui.git" },
	"publishConfig": { "registry": "https://npm.pkg.github.com", "access": "restricted" },
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"docs/PACKAGE.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./ext": {
			"types": "./dist/ext/index.d.ts",
			"svelte": "./dist/ext/index.js",
			"default": "./dist/ext/index.js"
		},
		"./charts": {
			"types": "./dist/charts/index.d.ts",
			"svelte": "./dist/charts/index.js",
			"default": "./dist/charts/index.js"
		},
		"./charts/*.svelte": {
			"types": "./dist/charts/*.svelte.d.ts",
			"svelte": "./dist/charts/*.svelte",
			"default": "./dist/charts/*.svelte"
		},
		"./ext/*.css": "./dist/ext/*.css",
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"svelte": "./dist/icons/index.js",
			"default": "./dist/icons/index.js"
		},
		"./icons/*.svelte": {
			"types": "./dist/icons/*.svelte.d.ts",
			"svelte": "./dist/icons/*.svelte",
			"default": "./dist/icons/*.svelte"
		},
		"./components/TableGrid": {
			"types": "./dist/components/TableGrid/index.d.ts",
			"svelte": "./dist/components/TableGrid/index.js",
			"default": "./dist/components/TableGrid/index.js"
		},
		"./components/*.svelte": {
			"types": "./dist/components/*.svelte.d.ts",
			"svelte": "./dist/components/*.svelte",
			"default": "./dist/components/*.svelte"
		},
		"./components/*.js": {
			"types": "./dist/components/*.d.ts",
			"svelte": "./dist/components/*.js",
			"default": "./dist/components/*.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"svelte": "./dist/hooks/index.js",
			"default": "./dist/hooks/index.js"
		},
		"./hooks/*.js": {
			"types": "./dist/hooks/*.d.ts",
			"svelte": "./dist/hooks/*.js",
			"default": "./dist/hooks/*.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"svelte": "./dist/actions/index.js",
			"default": "./dist/actions/index.js"
		},
		"./actions/*.js": {
			"types": "./dist/actions/*.d.ts",
			"svelte": "./dist/actions/*.js",
			"default": "./dist/actions/*.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"svelte": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		},
		"./utils/*.js": {
			"types": "./dist/utils/*.d.ts",
			"svelte": "./dist/utils/*.js",
			"default": "./dist/utils/*.js"
		},
		"./styles": {
			"types": "./dist/styles/index.d.ts",
			"style": "./dist/styles/index.css",
			"default": "./dist/styles/index.css"
		},
		"./styles/*": "./dist/styles/*",
		"./themes/*": "./dist/styles/themes/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"scripts": {
		"dev": "vite dev --port 5180 --host 127.0.0.1 --strictPort",
		"build": "vite build",
		"package": "node tools/gen-barrel.mjs && svelte-package && node tools/build-package-assets.mjs",
		"prepack": "npm run package",
		"package:check": "publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:lib": "node tools/check-lib-types.mjs",
		"lint": "eslint src/lib --max-warnings 74",
		"lint:styles": "stylelint \"src/lib/**/*.{css,svelte}\" --max-warnings 36",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots",
		"mirror": "node tools/serve.mjs",
		"snapshot": "python tools/snapshot.py",
		"compare": "python tools/compare.py",
		"bench:size": "node tools/bench/size.mjs",
		"bench:runtime": "python tools/bench/runtime.py",
		"bench:report": "python tools/bench/report.py"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"attr-accept": "^2.2.5",
		"card-validator": "^10.0.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.13",
		"imask": "^7.6.1",
		"virtua": "^0.41.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.3.11",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"lightningcss": "^1.33.0",
		"postcss-html": "^2.0.0",
		"publint": "^0.3.24",
		"stylelint": "^17.15.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.0.16",
		"vitest": "^3.2.7"
	}
}
